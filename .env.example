# media-ingest / watch — minimum config
#
# Copy to ~/.config/watch/.env (preferred, mode 0600) or to a project-local .env.
# `python3 scripts/setup.py` will scaffold the canonical file at ~/.config/watch/.env.
#
# At least ONE of GROQ_API_KEY / OPENAI_API_KEY / MULTIMODAL_API_KEY is required
# for transcription on sources without native captions. With none set, the skill
# still works frames-only (use --no-whisper --no-multimodal).

# --- Whisper (speech transcription) ---
# Preferred: cheaper, faster. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Fallback. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Multimodal (joint audio+visual; non-speech audio understanding) ---
# Default provider: NVIDIA NIM. Get a key at https://build.nvidia.com
# Provider-agnostic — point BASE_URL at any OpenAI-compatible multimodal endpoint
# (OpenRouter, local vLLM, etc.).
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=https://integrate.api.nvidia.com/v1
MULTIMODAL_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Legacy alias for MULTIMODAL_API_KEY (read as fallback only).
# NGC_API_KEY=

# Set automatically by scripts/setup.py once deps + a key are present.
# SETUP_COMPLETE=true
